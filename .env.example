# Copiez ce fichier en `.env` et renseignez les valeurs de votre projet Supabase
# (Project Settings > API sur supabase.com). Ces variables sont exposées côté
# client par Expo (préfixe EXPO_PUBLIC_) : n'y mettez jamais la clé "service_role".
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
